<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- FFmpeg 指针操作需要 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RaceProbe</AssemblyName>
    <RootNamespace>ClassIslandInjector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <!-- audio 模式：渲染带音频要跑真实的渲染器 + 离线混音（NAudio 只是 ProjectAudioMixer 的编译依赖）。 -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.25" />
    <Compile Include="..\..\FFmpegVideoDecoder.cs" Link="FFmpegVideoDecoder.cs" />
    <Compile Include="..\..\FFmpegVideoEncoder.cs" Link="FFmpegVideoEncoder.cs" />
    <Compile Include="..\..\FFmpegAudioDecoder.cs" Link="FFmpegAudioDecoder.cs" />
    <Compile Include="..\..\AudioSpeedReader.cs" Link="AudioSpeedReader.cs" />
    <Compile Include="..\..\VideoFrameSource.cs" Link="VideoFrameSource.cs" />
    <Compile Include="..\..\VideoProject.cs" Link="VideoProject.cs" />
    <Compile Include="..\..\VideoTranscoder.cs" Link="VideoTranscoder.cs" />
    <Compile Include="..\..\ProjectAudioMixer.cs" Link="ProjectAudioMixer.cs" />
    <Compile Include="..\..\VideoProjectPlayer.cs" Link="VideoProjectPlayer.cs" />
    <Compile Include="..\..\VideoProjectRenderer.cs" Link="VideoProjectRenderer.cs" />
    <Compile Include="..\..\OverlayFrameGenerator.cs" Link="OverlayFrameGenerator.cs" />
    <Compile Include="..\..\FilterUtils.cs" Link="FilterUtils.cs" />
  </ItemGroup>

</Project>
