<!--
  This file is loaded after ClassIsland's own main-window theme. It is copied to
  the plugin configuration folder on first run, so updates never overwrite edits.
  Save this file to hot-reload it while ClassIsland is running.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The host window and the island root get these classes at runtime. -->
  <Style Selector="Window.classisland-injector">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--
  Source-level anchors in ClassIsland.MainWindow.axaml:
    Window.classisland-injector
    Grid#WindowRoot
    Panel#WorkingRoot
    StackPanel#StackPanelRootContainer.classisland-injector-root
    Grid#GridRoot

  Example:
  <Style Selector="Grid#GridRoot">
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  -->
</Styles>
