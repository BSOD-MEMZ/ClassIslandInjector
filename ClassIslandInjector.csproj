<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClassIslandInjector</AssemblyName>
    <RootNamespace>ClassIslandInjector</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CreateCipx>true</CreateCipx>
    <!-- tools\ 下的独立工具项目（如 SmtcProbe 探针）不应被本插件项目编译 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.0.0.2">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="MaterialColorUtilities" Version="0.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.25" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Defaults\Overrides.axaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Firework.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Firework_new.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ColorBall.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\explode.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
