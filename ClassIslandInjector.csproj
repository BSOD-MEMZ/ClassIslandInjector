<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClassIslandInjector</AssemblyName>
    <RootNamespace>ClassIslandInjector</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CreateCipx>true</CreateCipx>
    <!-- FFmpeg 解码（自带解码器，绕开系统 MF）需要指针操作 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- tools\ 下的独立工具项目（如 SmtcProbe 探针）不应被本插件项目编译 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.0.0.2">
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="MaterialColorUtilities" Version="0.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.25" />
  </ItemGroup>

  <!--
    cipx 包体优化：宿主 ClassIsland 自带 Microsoft.Windows.SDK.NET.dll / WinRT.Runtime.dll，
    且 PluginLoadContext 强制使用宿主版本（拒绝从插件目录加载）——这两个 DLL 打进插件包
    是纯冗余（约 24.8MB）。调试符号 pdb 也无需随包分发。
    打包前把它们临时移出 OutputPath，打包后移回，保证 bin 产物完整（本地部署依赖）。
  -->
  <Target Name="TrimCipxInput" BeforeTargets="CreateCipx">
    <PropertyGroup>
      <_CipxStaging>$(BaseIntermediateOutputPath)cipx-staging\</_CipxStaging>
    </PropertyGroup>
    <MakeDir Directories="$(_CipxStaging)" />
    <Move SourceFiles="$(OutputPath)Microsoft.Windows.SDK.NET.dll" DestinationFolder="$(_CipxStaging)" Condition="Exists('$(OutputPath)Microsoft.Windows.SDK.NET.dll')" />
    <Move SourceFiles="$(OutputPath)WinRT.Runtime.dll" DestinationFolder="$(_CipxStaging)" Condition="Exists('$(OutputPath)WinRT.Runtime.dll')" />
    <Move SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(_CipxStaging)" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    <!-- FFmpeg 原生库绝不能进 cipx：运行时按需把库下载到「配置目录\ffmpeg」，插件包不应携带任何 avcodec 等。
         若有人把 FFmpeg dll 拷进输出目录（本机排错用），打包前先移走、打包后移回，确保包体干净。 -->
    <ItemGroup>
      <_FfmpegStray Include="$(OutputPath)avcodec-*.dll;$(OutputPath)avformat-*.dll;$(OutputPath)avutil-*.dll;$(OutputPath)swscale-*.dll;$(OutputPath)swresample-*.dll" />
    </ItemGroup>
    <Move SourceFiles="@(_FfmpegStray)" DestinationFolder="$(_CipxStaging)" Condition="'@(_FfmpegStray)' != ''" />
  </Target>
  <Target Name="RestoreCipxInput" AfterTargets="CreateCipx">
    <Move SourceFiles="$(_CipxStaging)Microsoft.Windows.SDK.NET.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(_CipxStaging)Microsoft.Windows.SDK.NET.dll')" />
    <Move SourceFiles="$(_CipxStaging)WinRT.Runtime.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(_CipxStaging)WinRT.Runtime.dll')" />
    <Move SourceFiles="$(_CipxStaging)$(AssemblyName).pdb" DestinationFolder="$(OutputPath)" Condition="Exists('$(_CipxStaging)$(AssemblyName).pdb')" />
    <ItemGroup>
      <_FfmpegStrayBack Include="$(_CipxStaging)avcodec-*.dll;$(_CipxStaging)avformat-*.dll;$(_CipxStaging)avutil-*.dll;$(_CipxStaging)swscale-*.dll;$(_CipxStaging)swresample-*.dll" />
    </ItemGroup>
    <Move SourceFiles="@(_FfmpegStrayBack)" DestinationFolder="$(OutputPath)" Condition="'@(_FfmpegStrayBack)' != ''" />
  </Target>

  <ItemGroup>
    <None Update="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Defaults\Overrides.axaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Defaults\Tutorials\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Defaults\contract-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Defaults\contract-index.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Firework.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Firework_new.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ColorBall.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\explode.gif" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\album.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\editorbackground.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SMTCTutorialBanner.webp" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\EditorTutorialBanner.webp" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\aerostripe.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\aeroleft.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\aeroright.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\pjsk\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\pjsk\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Music\**\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Stickers\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
