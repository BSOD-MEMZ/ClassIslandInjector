{
  "Id": "classislandInjector.tutorials",
  "Title": "ClassIslandInjector",
  "Description": "ClassIslandInjector 插件的使用教程。",
  "Tutorials": [
    {
      "Id": "classislandInjector.tutorials.wallpaperEditor",
      "Title": "底图编辑器入门",
      "Description": "Miku和Airi带你学会底图编辑器（ooc致歉）",
      "Ordinary": 0,
      "Banner": "{assetsUri}/TutorialBanner.webp",
      "Paragraphs": [
        {
          "Id": "prologue",
          "Title": "开始之前",
          "TopLevelClassName": "ClassIslandInjector.Views.WallpaperLayerEditorWindow",
          "InitializeActions": [],
          "Content": [
            {
              "Title": "",
              "Content": "你打开了 ClassIslandInjector 的底图图层编辑器，要学会使用它要下点功夫呢！不过别担心——",
              "IconExpression": "",
              "UseLightDismiss": true,
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "初音未来",
              "Content": "嗨～ 我是初音未来！这个编辑器怎么用，就由我和爱莉来教你吧！",
              "IconExpression": "bitmap({stickerUri}/miku_welcome.png)",
              "UseLightDismiss": true,
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "桃井爱莉",
              "Content": "我是桃井爱莉☆~接下来要认真教你，听好了，可别半途而废哦？",
              "IconExpression": "bitmap({stickerUri}/Airi_01.png)",
              "UseLightDismiss": true,
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "准备好了吗？",
              "Content": "好～那我就开始了～！",
              "IconExpression": "bitmap({stickerUri}/miku_happy.png)",
              "UseLightDismiss": false,
              "RightButtonText": "开始",
              "RightButtonActions": [
                {
                  "Kind": 3
                }
              ],
              "LeftButtonText": ""
            }
          ],
          "IsBarrierEnabled": true
        },
        {
          "Id": "act1-stage",
          "Title": "认识界面",
          "TopLevelClassName": "ClassIslandInjector.Views.WallpaperLayerEditorWindow",
          "InitializeActions": [],
          "Content": [
            {
              "Title": "画布",
              "Content": "中间这块大画布，就是主界面的预览。底图会贴在这里。",
              "IconExpression": "bitmap({stickerUri}/miku_happy.png)",
              "TargetSelector": "#EditorCanvas",
              "PlacementMode": 1,
              "PointToTarget": true,
              "UseLightDismiss": false,
              "RightButtonText": "下一步",
              "LeftButtonText": ""
            },
            {
              "Title": "",
              "Content": "——注意：画布里的主界面只是用来参考位置的，它和真实主界面长得不一样，这很正常。这里用的是相对定位：图片锚定在主界面的某一边，主界面怎么变，图片就跟着那一边走，比固定像素位置智能得多。",
              "IconExpression": "",
              "UseLightDismiss": true,
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "工具栏",
              "Content": "左侧是工具栏：移动、选择、缩放、形状、文本、抓手。",
              "IconExpression": "bitmap({stickerUri}/Airi_04.png)",
              "TargetSelector": "#EditorToolBar",
              "PlacementMode": 1,
              "PointToTarget": true,
              "UseLightDismiss": false,
              "RightButtonText": "下一步",
              "LeftButtonText": ""
            },
            {
              "Title": "图层面板",
              "Content": "右下角是图层面板。图层越靠上，显示得越靠前。拖动手柄可以调整顺序。",
              "IconExpression": "bitmap({stickerUri}/miku_happy.png)",
              "TargetSelector": "#EditorLayerPanel",
              "PlacementMode": 0,
              "PointToTarget": true,
              "UseLightDismiss": false,
              "RightButtonText": "下一步",
              "LeftButtonText": ""
            },
            {
              "Title": "命令栏",
              "Content": "顶部是命令栏，添加图片、撤销、保存都在这里。准备好了吗？现在该你动手啦~",
              "IconExpression": "bitmap({stickerUri}/Airi_08.png)",
              "TargetSelector": "#EditorAddImage",
              "HighlightTarget": true,
              "PlacementMode": 1,
              "PointToTarget": true,
              "UseLightDismiss": false,
              "RightButtonText": "开始练习",
              "RightButtonActions": [
                {
                  "Kind": 3
                }
              ],
              "LeftButtonText": ""
            }
          ],
          "IsBarrierEnabled": true
        },
        {
          "Id": "act2-scene",
          "Title": "动手练习",
          "TopLevelClassName": "ClassIslandInjector.Views.WallpaperLayerEditorWindow",
          "InitializeActions": [],
          "Content": [
            {
              "Title": "第一步 · 添加图片",
              "Content": "先点「添加图片图层」，选一张你喜欢的图片。如果手头没有，就选对话框里的「使用示例图片」，我们给你准备了一张！",
              "IconExpression": "bitmap({stickerUri}/miku_thumbup.png)",
              "TargetSelector": "#EditorAddImage",
              "HighlightTarget": true,
              "ModalTarget": true,
              "PlacementMode": 1,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "add-image",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "第二步 · 摆位置",
              "Content": "图片加好了。用鼠标拖住它，放到你觉得合适的位置。",
              "IconExpression": "bitmap({stickerUri}/miku_happy.png)",
              "TargetSelector": "#EditorCanvas",
              "HighlightTarget": true,
              "ModalTarget": true,
              "PlacementMode": 1,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "move",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "第三步 · 解锁主界面",
              "Content": "接下来，去图层面板点一下「ClassIsland 主界面」那一行的解锁。不解锁的话，主界面是拖不动的。",
              "IconExpression": "bitmap({stickerUri}/Airi_11.png)",
              "TargetSelector": "#EditorLayerPanel",
              "HighlightTarget": true,
              "PlacementMode": 0,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "unlock",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "咦？已经解锁了？",
              "Content": "咦？你已经解锁了？……那可不行！先把主界面锁回去，再重新解锁一遍，我要亲眼确认你的操作！",
              "IconExpression": "bitmap({stickerUri}/Airi_11.png)",
              "TargetSelector": "#EditorLayerPanel",
              "HighlightTarget": true,
              "PlacementMode": 0,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "unlock-reset",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "第四步 · 看跟随效果",
              "Content": "解锁后，拖动主界面的边缘改变一下大小，看看图片是不是还贴在自己那边？这就是相对定位的效果。",
              "IconExpression": "bitmap({stickerUri}/miku_happy.png)",
              "TargetSelector": "#EditorCanvas",
              "HighlightTarget": true,
              "ModalTarget": true,
              "PlacementMode": 1,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "resize",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "第五步 · 画个形状",
              "Content": "接下来试个形状。点左侧的「形状」工具，在画布上拖出一个形状。",
              "IconExpression": "bitmap({stickerUri}/Airi_13.png)",
              "TargetSelector": "#EditorShapeTool",
              "HighlightTarget": true,
              "PlacementMode": 1,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "shape",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "第六步 · 换形状类型",
              "Content": "画好了？在右侧检查器里可以换成别的形状类型：矩形、椭圆、心形……试试看。",
              "IconExpression": "bitmap({stickerUri}/Airi_08.png)",
              "TargetSelector": "#EditorShapeType",
              "HighlightTarget": true,
              "PlacementMode": 2,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "shape-type",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "第七步 · 加点文字",
              "Content": "最后是文字。点左侧的「文本」工具，再到画布上点一下，就能加一行文字了。",
              "IconExpression": "bitmap({stickerUri}/miku_happy.png)",
              "TargetSelector": "#EditorTextTool",
              "HighlightTarget": true,
              "PlacementMode": 1,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "text",
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "第八步 · 保存",
              "Content": "差不多了就点「保存并应用」。记得多保存几次，每次改动都能马上看到效果。",
              "IconExpression": "bitmap({stickerUri}/miku_thumbup.png)",
              "TargetSelector": "#EditorSave",
              "HighlightTarget": true,
              "ModalTarget": true,
              "PlacementMode": 1,
              "PointToTarget": true,
              "WaitForNextCommand": true,
              "UseLightDismiss": false,
              "Tag": "save",
              "RightButtonText": "",
              "LeftButtonText": ""
            }
          ],
          "IsBarrierEnabled": true
        },
        {
          "Id": "epilogue",
          "Title": "结束",
          "TopLevelClassName": "ClassIslandInjector.Views.WallpaperLayerEditorWindow",
          "InitializeActions": [],
          "Content": [
            {
              "Title": "",
              "Content": "——到这里，底图编辑器的基础操作就都过了一遍。",
              "IconExpression": "",
              "UseLightDismiss": true,
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "桃井爱莉",
              "Content": "……没想到你学得还挺快。做得不错，我就勉为其难夸你一句好了。",
              "IconExpression": "bitmap({stickerUri}/Airi_17.png)",
              "UseLightDismiss": true,
              "RightButtonText": "",
              "LeftButtonText": ""
            },
            {
              "Title": "初音未来",
              "Content": "哇，爱莉居然夸人了！总之，以后随时欢迎回来继续打造你的专属主界面，拜拜☆～",
              "IconExpression": "bitmap({stickerUri}/miku_bye.png)",
              "UseLightDismiss": false,
              "RightButtonText": "再见",
              "RightButtonActions": [
                {
                  "Kind": 6
                }
              ],
              "LeftButtonText": ""
            }
          ],
          "IsBarrierEnabled": true
        }
      ]
    }
  ]
}
